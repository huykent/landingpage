# ===================================================
# NALIENTHANH.STORE - BIẾN MÔI TRƯỜNG CẤU HÌNH
# ===================================================

# 1. Mã Facebook Pixel để cắm và theo dõi chuyển đổi Facebook Ads
# Lấy từ Meta Events Manager (Trình quản lý sự kiện Facebook)
NEXT_PUBLIC_FB_PIXEL_ID=1234567890123456

# 2. Mã PIN đăng nhập trang Quản trị Đơn hàng Sales (/admin)
ADMIN_PIN=your_secret_admin_pin

# 3. Cấu hình Báo đơn tức thì qua Telegram (Tùy chọn)
# Tạo bot qua @BotFather và lấy Chat ID từ nhóm chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Cấu hình Đồng bộ Đơn hàng vào Google Sheets (Tùy chọn)
# URL Webhook triển khai từ Google Apps Script
GOOGLE_SHEET_WEBHOOK_URL=
